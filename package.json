{
  "name": "ai-academy-miaoda-showcase",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A sanitized product case study for an enterprise learning platform with controlled AI workflows.",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=scripts/privacy-check.mjs --test-coverage-include=scripts/screenshot-manifest.mjs --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80",
    "privacy:check": "node scripts/privacy-check.mjs",
    "screenshots:manifest": "node scripts/screenshot-manifest.mjs",
    "screenshots:ocr": "node scripts/ocr-check.mjs",
    "serve": "python3 -m http.server 4173"
  },
  "engines": {
    "node": ">=22"
  }
}
